# Copy this file to .env and fill in real values. Never commit .env itself.

# A long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Postgres connection string: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://portfolio_user:devpassword@localhost:5432/portfolio_db

# Get a key from https://console.anthropic.com/ (Settings -> API Keys).
# Leave blank to run everything except the AI chat widget, which will show
# a friendly "not configured yet" message instead of erroring.
ANTHROPIC_API_KEY=

# Which Claude model powers the chat widget. claude-haiku-4-5 is fast and
# cheap, which fits a simple portfolio Q&A bot well. See
# https://docs.claude.com/en/docs/about-claude/models for other options.
AI_MODEL=claude-haiku-4-5

# Credentials for the ONE dashboard account, created the first time you run
# seed_data.py. Change ADMIN_PASSWORD from its default before your first run,
# or change it from the dashboard's Account tab right after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

SITE_OWNER_NAME=Aashish Upreti

# Set to true once you're serving over HTTPS in production.
SESSION_COOKIE_SECURE=false
